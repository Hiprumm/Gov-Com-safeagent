# ============================================================
# SafeAgent 环境变量配置模板
# 复制此文件为 .env 并填写实际值
#   cp .env.example .env
# ============================================================

# ======== LLM API Key ========
# 智谱AI API Key (https://open.bigmodel.cn/)
ZHIPU_API_KEY=

# ======== 服务器配置 ========
HOST=0.0.0.0
PORT=8080
WORKERS=2

# ======== CORS ========
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ======== 日志 ========
LOG_LEVEL=INFO
DEBUG=false

# ======== 限流（生产环境启用） ========
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ======== 请求限制 ========
MAX_REQUEST_SIZE_MB=10
MAX_FILE_SIZE_MB=50

# ======== 运行环境（生产级改造）========
# development=演示/开发（保留默认口令 admin123、允许沙箱本地降级兜底）
# production=生产（强制鉴权、禁默认口令/禁沙箱降级/密钥必须显式注入，否则拒绝启动）
ENV=development

# ======== 基本鉴权（公网部署时启用） ========
AUTH_ENABLED=false
AUTH_API_KEY=

# ======== 认证与会话（S1 认证加固，生产务必配置） ========
# JWT 签名密钥：留空则每次启动随机生成（重启后全部令牌失效）。生产请填入足够长的随机串
AUTH_JWT_SECRET=
# 访问令牌有效期（秒），默认 8 小时
AUTH_TOKEN_TTL_SECONDS=28800
# 连续登录失败上限与锁定时长（秒）
AUTH_LOGIN_MAX_FAILS=5
AUTH_LOGIN_LOCK_SECONDS=300
# 口令强度策略
AUTH_PASSWORD_MIN_LEN=8
AUTH_PASSWORD_REQUIRE_COMPLEXITY=true
# MFA（TOTP）开关
AUTH_MFA_ENABLED=true
AUTH_MFA_ISSUER=SafeAgent
# 敏感字段（MFA TOTP 密钥）加密密钥：留空则用 data/mfa_key.key（多实例需一致，建议显式配置）
AUTH_MFA_SECRET_KEY=

# ======== 审计链签名密钥（生产级改造：ENV=production 时必须显式注入，openssl rand -hex 32）========
GRADED_HMAC_KEY=
ZKP_PROVING_KEY=

# ======== SSO（受信网关头免密登录，可选） ========
# 受信网关头名，如 X-Remote-User；配置后启用 SSO
AUTH_SSO_TRUSTED_HEADER=
# 网关共享密钥：配置后强制校验 X-SSO-Signature=HMAC-SHA256(secret, "<头名>:<用户名>")（防伪造受信头）
AUTH_SSO_SHARED_SECRET=
# 来源 IP 白名单（逗号分隔，如 10.0.0.5,10.0.0.6；建议与共享密钥同时配置）
AUTH_SSO_ALLOWED_IPS=

# ======== 存储 ========
SQLITE_PATH=
# 存储后端：sqlite（默认，零依赖）| postgres（生产推荐，需安装 psycopg[binary]）
STORAGE_BACKEND=sqlite
# PostgreSQL 连接（STORAGE_BACKEND=postgres 时生效；可只填 POSTGRES_DSN）
POSTGRES_DSN=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safeagent
POSTGRES_USER=safeagent
POSTGRES_PASSWORD=

# ======== 检测阈值 ========
ATTACK_THRESHOLD_LOW=0.3
ATTACK_THRESHOLD_MEDIUM=0.6
ATTACK_THRESHOLD_HIGH=0.85
PLUGIN_SAFETY_THRESHOLD=70
MAX_CONTEXT_LENGTH=8192
MAX_INPUT_LENGTH=4096

# ======== 基础设施（生产环境配置） ========
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# REDIS_HOST=localhost
# REDIS_PORT=6379
# ELASTICSEARCH_URL=http://localhost:9200

# ======== 工具沙箱（生产级改造）========
# 沙箱不可用时的策略：0=拒绝执行（默认，生产强制）；1=降级本地受限执行（仅开发调试）
SANDBOX_ALLOW_LOCAL_FALLBACK=0
# 允许出站的工具白名单（逗号分隔，默认空=deny-all）
TOOL_NETWORK_WHITELIST=

# ======== 检测流水线（生产级改造）========
# LLM 语义仲裁超时（毫秒），默认 2000
LLM_ARBITER_TIMEOUT_MS=2000

# ======== 审计链（生产级改造）========
# 多 TSA 端点（逗号分隔，主备依次尝试，全失败才本地降级）
TSA_ENDPOINTS=
# 审计日志保留天数（备份保留周期对齐）
AUDIT_RETENTION_DAYS=180

# ======== 可观测性（生产级改造）========
# 日志格式：json（生产推荐）| text（开发可读）
LOG_FORMAT=json
# 暴露 /metrics Prometheus 指标
METRICS_ENABLED=true
# IP 维度限流（每分钟，网关用户+IP 双维度叠加）
RATE_LIMIT_IP_REQUESTS=120
