# ============================================================
# SafeAgent 环境变量配置模板
# 复制此文件为 .env 并填写实际值
#   cp .env.example .env
# ============================================================

# ======== LLM API Key ========
# 智谱AI API Key (https://open.bigmodel.cn/)
ZHIPU_API_KEY=

# ======== 服务器配置 ========
HOST=0.0.0.0
PORT=8080
WORKERS=2

# ======== CORS ========
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ======== 日志 ========
LOG_LEVEL=INFO
DEBUG=false

# ======== 限流（生产环境启用） ========
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ======== 请求限制 ========
MAX_REQUEST_SIZE_MB=10
MAX_FILE_SIZE_MB=50

# ======== 基本鉴权（公网部署时启用） ========
AUTH_ENABLED=false
AUTH_API_KEY=

# ======== 存储 ========
SQLITE_PATH=

# ======== 检测阈值 ========
ATTACK_THRESHOLD_LOW=0.3
ATTACK_THRESHOLD_MEDIUM=0.6
ATTACK_THRESHOLD_HIGH=0.85
PLUGIN_SAFETY_THRESHOLD=70
MAX_CONTEXT_LENGTH=8192
MAX_INPUT_LENGTH=4096

# ======== 基础设施（生产环境配置） ========
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# REDIS_HOST=localhost
# REDIS_PORT=6379
# ELASTICSEARCH_URL=http://localhost:9200
