# ============================================================
# SafeAgent 环境变量配置模板
# 复制此文件为 .env 并填写实际值
#   cp .env.example .env
# ============================================================

# ======== LLM API Key ========
# 智谱AI API Key (https://open.bigmodel.cn/)
ZHIPU_API_KEY=

# ======== 服务器配置 ========
HOST=0.0.0.0
PORT=8080
WORKERS=2

# ======== CORS ========
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ======== 日志 ========
LOG_LEVEL=INFO
DEBUG=false

# ======== 限流（生产环境启用） ========
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# ======== 请求限制 ========
MAX_REQUEST_SIZE_MB=10
MAX_FILE_SIZE_MB=50

# ======== 基本鉴权（公网部署时启用） ========
AUTH_ENABLED=false
AUTH_API_KEY=

# ======== 认证与会话（S1 认证加固，生产务必配置） ========
# JWT 签名密钥：留空则每次启动随机生成（重启后全部令牌失效）。生产请填入足够长的随机串
AUTH_JWT_SECRET=
# 访问令牌有效期（秒），默认 8 小时
AUTH_TOKEN_TTL_SECONDS=28800
# 连续登录失败上限与锁定时长（秒）
AUTH_LOGIN_MAX_FAILS=5
AUTH_LOGIN_LOCK_SECONDS=300

# ======== 存储 ========
SQLITE_PATH=
# 存储后端：sqlite（默认，零依赖）| postgres（生产推荐，需安装 psycopg[binary]）
STORAGE_BACKEND=sqlite
# PostgreSQL 连接（STORAGE_BACKEND=postgres 时生效；可只填 POSTGRES_DSN）
POSTGRES_DSN=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=safeagent
POSTGRES_USER=safeagent
POSTGRES_PASSWORD=

# ======== 检测阈值 ========
ATTACK_THRESHOLD_LOW=0.3
ATTACK_THRESHOLD_MEDIUM=0.6
ATTACK_THRESHOLD_HIGH=0.85
PLUGIN_SAFETY_THRESHOLD=70
MAX_CONTEXT_LENGTH=8192
MAX_INPUT_LENGTH=4096

# ======== 基础设施（生产环境配置） ========
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# REDIS_HOST=localhost
# REDIS_PORT=6379
# ELASTICSEARCH_URL=http://localhost:9200
